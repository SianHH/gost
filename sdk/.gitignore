# Build outputs.

# Android shared libraries and the staged header, produced by
# scripts/build-android.sh.
/jniLibs/

# Host-platform shared libraries and the smoke-test binary, produced by
# scripts/build-native.sh / build-native.ps1.
/build/

# The header is generated by cgo on every build, next to the -o target. The
# copy that ships is the one inside jniLibs/ or build/.
/libgost.h
/gost.h
